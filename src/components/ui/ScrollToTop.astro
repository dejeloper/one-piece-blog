<button
  id="scroll-to-top"
  type="button"
  aria-label="Volver al inicio del capítulo"
  title="Volver arriba"
  class="fixed right-4 bottom-5 z-40 flex size-12 translate-y-3 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--primary)] text-white opacity-0 shadow-[0_8px_24px_rgba(58,31,26,0.28)] pointer-events-none transition-[opacity,transform,background-color] duration-200 hover:bg-[var(--secondary)] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[var(--ring)] sm:right-6 sm:bottom-7"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-6"
  >
    <path d="m6 15 6-6 6 6"></path>
  </svg>
</button>

<script>
  const buttonId = "scroll-to-top";
  const visibilityThreshold = 480;

  const updateScrollButton = () => {
    const button = document.getElementById(buttonId);
    if (!button) return;

    const isVisible = window.scrollY > visibilityThreshold;
    button.classList.toggle("opacity-0", !isVisible);
    button.classList.toggle("translate-y-3", !isVisible);
    button.classList.toggle("pointer-events-none", !isVisible);
    button.classList.toggle("opacity-100", isVisible);
    button.classList.toggle("translate-y-0", isVisible);
  };

  const initializeScrollButton = () => {
    const button = document.getElementById(buttonId);
    if (!button) return;

    if (button.dataset.initialized !== "true") {
      button.dataset.initialized = "true";
      button.addEventListener("click", () => {
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
      });
    }

    updateScrollButton();
  };

  if (document.documentElement.dataset.scrollToTopListener !== "true") {
    document.documentElement.dataset.scrollToTopListener = "true";
    document.addEventListener("scroll", updateScrollButton, { passive: true });
    document.addEventListener("astro:page-load", initializeScrollButton);
  }

  initializeScrollButton();
</script>
