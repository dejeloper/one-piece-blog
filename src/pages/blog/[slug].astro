---
import Layout from "@layouts/Layout.astro";
import { getAllPostsSlugs, getPostsInfo } from "@lib/wp";
import ChapterNavButton from "@components/ui/ChapterNavButton.astro";

const slug = Astro.params.slug;
if (!slug) {
  throw new Error("Slug is required");
}

const {
  title,
  date,
  content,
  excerpt,
  featuredImage,
  alt_text_image,
  isFirst,
  isLast,
  prevSlug,
  nextSlug,
  prevTitle,
  nextTitle,
  chapterNumber,
  tags,
} = await getPostsInfo(slug);

const clueTags = tags.filter(
  (tag) => tag.slug.toLocaleLowerCase() !== "historia",
);

export async function getStaticPaths() {
  const slugs: string[] = await getAllPostsSlugs();
  return slugs.map((slug: string) => ({ params: { slug } }));
}
---

<Layout
  title={`Capítulo ${chapterNumber} - ${title}`}
  description={excerpt || "Blog sobre El viaje hacia la libertad."}
  ogimage={featuredImage}
  schemaType="BlogPosting"
  publishedDate={new Date(date).toISOString()}
>
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-1 bg-[var(--primary)] z-50 w-0"
  >
  </div>
  <div class="pt-8 pb-16 lg:pt-8 lg:pb-12 antialiased">
    <article class="prose prose-lg mx-auto max-w-3xl px-2">
      <div class="not-prose mb-5 px-1 sm:px-0">
        <ChapterNavButton
          prevSlug={prevSlug}
          prevTitle={prevTitle}
          nextSlug={nextSlug}
          nextTitle={nextTitle}
          isFirst={isFirst}
          isLast={isLast}
        />
      </div>

      <div
        class="rounded-[1.25rem] sm:rounded-2xl px-5 py-7 sm:px-9 sm:py-10 bg-gradient-to-b from-[rgba(250,239,236,0.96)] to-[rgba(250,239,236,0.92)] shadow-[0_10px_25px_rgba(58,31,26,0.08),inset_0_0_0_1px_rgba(196,138,125,0.25)]"
      >
        <header class="text-center mb-10">
          <div class="not-prose mb-2 flex flex-col items-center justify-center gap-1">
            <span
              class="inline-flex items-center rounded-full bg-[var(--primary)]/10 px-2.5 py-0.5 text-[13px] font-semibold uppercase tracking-wide text-[var(--primary)]"
            >
              Capítulo {chapterNumber}
            </span>
            {clueTags.map((tag) => (
              <a
                href={`/chapters?tag=${encodeURIComponent(tag.slug)}`}
                aria-label={`Ver capítulos de ${tag.name}`}
                class="inline-flex items-center rounded-full border border-[var(--primary)]/20 bg-white/40 px-2.5 py-0.5 text-[11px] font-medium text-[var(--primary)] no-underline transition-colors hover:border-[var(--primary)]/40 hover:bg-white/70"
              >
                {tag.name}
              </a>
            ))}
          </div>
          <h1
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight
           text-[var(--foreground)] leading-tight mb-2"
          >
            {title}
          </h1>
          <div
            class="mx-auto mt-6 h-[3px] w-1/2 rounded-full
           bg-gradient-to-r from-[var(--primary)]/60 to-[var(--primary)]/20"
          >
          </div>
        </header>

        {
          featuredImage && (
            <figure class="my-8 mb-14 sm:my-10">
              <img
                src={featuredImage}
                alt={alt_text_image}
                title={alt_text_image}
                width={1200}
                height={675}
                class="w-full h-auto object-cover rounded-xl shadow-md"
                loading="lazy"
                decoding="async"
              />
              {excerpt && (
                <figcaption class="mt-2 text-xs text-gray-500 italic text-center">
                  {excerpt}
                </figcaption>
              )}
            </figure>
          )
        }

        <div
          class="prose prose-neutral max-w-none text-[1.05rem] sm:text-[1.125rem] leading-[1.9] tracking-[0.006em] [&_p]:mb-[1.9em] [&_h2]:mt-[2.4em] [&_h3]:mt-[2em] [&_ul]:my-[1.6em] [&_li]:mb-[0.6em] [&_blockquote]:border-l-4 [&_blockquote]:pl-4 [&_blockquote]:italic [&_img]:rounded-xl text-[var(--foreground)]"
          set:html={content}
        />

      </div>

      <footer class="not-prose mt-5 px-1 sm:px-0">
        <ChapterNavButton
          prevSlug={prevSlug}
          prevTitle={prevTitle}
          nextSlug={nextSlug}
          nextTitle={nextTitle}
          isFirst={isFirst}
          isLast={isLast}
        />
      </footer>
    </article>
  </div>

  <script>
    document.addEventListener("scroll", () => {
      const doc = document.documentElement;
      const progress =
        (doc.scrollTop / (doc.scrollHeight - doc.clientHeight)) * 100;
      const bar = document.getElementById("reading-progress");
      if (bar) bar.style.width = `${progress}%`;
    });
  </script>
</Layout>
