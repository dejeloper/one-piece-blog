---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";

import SEO from "@components/layouts/SEO.astro";
import Navbar from "@components/layouts/Navbar.astro";
import Footer from "@components/layouts/Footer.astro";
import TransitionLoader from "@components/ui/TransitionLoader.astro";

const { title, description, ogimage } = Astro.props;

const icon = "☠️";
const name = "El viaje hacia la libertad";
---

<!doctype html>
<html lang="es" style="visibility: hidden;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Critical CSS variables and styles to prevent FOUC -->
    <style is:inline>
      :root {
        --background: #f3e8e5;
        --foreground: #3a1f1a;
        --card: #faefec;
        --card-foreground: #3a1f1a;
        --popover: #edd2cd;
        --popover-foreground: #3a1f1a;
        --primary: #b64232;
        --primary-foreground: #fff;
        --secondary: #8c3f2e;
        --secondary-foreground: #fff;
        --muted: #d6b0a7;
        --muted-foreground: #5a2f28;
        --accent: #e85c41;
        --accent-foreground: #fff;
        --destructive: #a3261c;
        --destructive-foreground: #fff;
        --border: #c48a7d;
        --input: #faefec;
        --ring: rgba(232, 92, 65, 0.4);
      }
      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
      }
      body {
        width: 100%;
        margin: 0;
        padding: 0;
        background-color: var(--background);
        color: var(--foreground);
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      html.ready {
        visibility: visible;
      }
    </style>

    <!-- Script to show content as early as possible -->
    <script is:inline>
      document.documentElement.classList.add('ready');
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon-one-piece.svg" />

    <!-- SEO -->
    <SEO
      title={Astro.props.title || name}
      description={description ||
        "El viaje hacia la libertad: una historia de aventura y autodescubrimiento inspirada en el espíritu de One Piece. Un desarrollador colombiano abandona su vida estable para seguir una travesía global en busca de libertad."}
      url={Astro.url.href}
      author="Jhonatan Guerrero"
      keywords="fanfic one piece, fanfiction one piece, aventura, libertad, viaje, búsqueda personal, historia inspirada en one piece, aventura moderna, viaje personal, exploración, sueños, piratas, libertad y aventura"
      ogtitle={Astro.props.title || name}
      ogdescription={description ||
        "Una historia de aventura y búsqueda personal inspirada en One Piece. Un hombre deja atrás su vida estable para seguir un viaje hacia la libertad."}
      ogimage={ogimage}
    />

    <ClientRouter />
    <Analytics />
  </head>

  <body class="bg-[var(--background)] text-[var(--foreground)] relative">
    <TransitionLoader />

    <Navbar icon={icon} name={name} />
    <main class="min-h-screen">
      <slot />
    </main>
    <Footer />

    <script>
      const hideLoader = () => {
        const loader = document.getElementById("transition-loader");
        if (!loader) return;
        loader.style.opacity = "0";
        loader.style.pointerEvents = "none";
      };

      const showLoader = () => {
        const loader = document.getElementById("transition-loader");
        if (!loader) return;
        loader.style.opacity = "1";
        loader.style.pointerEvents = "auto";
      };

      // Hide loader when page is ready
      const handlePageReady = () => {
        document.documentElement.classList.add("ready");
        document.documentElement.style.scrollBehavior = "smooth";
        hideLoader();
      };

      // Hide loader on initial page load
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", handlePageReady);
      } else {
        handlePageReady();
      }

      // Handle transitions between pages
      document.addEventListener("astro:before-preparation", () => {
        document.documentElement.style.scrollBehavior = "auto";
        window.scrollTo(0, 0);
        document.documentElement.classList.remove("ready");
        showLoader();
      });

      document.addEventListener("astro:page-load", () => {
        handlePageReady();
      });
    </script>
  </body>
</html>
