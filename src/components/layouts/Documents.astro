<section class="py-16 border-b-1 border-[var(--primary)]/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-[var(--foreground)] mb-4">
        Documentos
      </h2>
      <p class="text-lg text-[var(--muted-foreground)] max-w-2xl mx-auto">
        Descubre documentos importantes y recursos valiosos para conocer mejor
        el viaje
      </p>
    </div>

    <!-- Accesos a documentos y pistas -->
    <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/documentos"
        data-astro-prefetch
        class="inline-block bg-[var(--primary)]/90 text-[var(--primary-foreground)] px-8 py-3 rounded-lg font-semibold text-lg transition-transform active:scale-95 hover:bg-[var(--primary)]"
      >
        Ver todos los documentos
        <svg
          class="w-5 h-5 ml-2 inline"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <a
        href="/pistas"
        data-astro-prefetch
        class="inline-block border border-[var(--primary)] text-[var(--primary)] px-8 py-3 rounded-lg font-semibold text-lg transition-all active:scale-95 hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)]"
      >
        Ver todas las pistas
        <svg
          class="w-5 h-5 ml-2 inline"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 18h6m-5 3h4m-7-9a5 5 0 1 1 10 0c0 2-1 3-2 4H9c-1-1-2-2-2-4Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</section>
