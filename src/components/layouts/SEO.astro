---
interface Props {
  title: string;
  description: string;
  url: string;
  author: string;
  keywords?: string;
  ogtitle: string;
  ogdescription: string;
  ogimage?: string;
  schemaType?: "BlogPosting" | "Blog";
  publishedDate?: string;
  modifiedDate?: string;
}

const {
  title,
  description,
  url,
  author,
  keywords = "",
  ogtitle,
  ogdescription,
  ogimage = "https://www.onepiece.dejeloper.com/images/preview2.webp",
  schemaType = "Blog",
  publishedDate,
  modifiedDate,
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": schemaType,
  ...(schemaType === "BlogPosting" && {
    headline: title,
    description,
    image: ogimage,
    author: {
      "@type": "Person",
      name: author,
      url: "https://www.onepiece.dejeloper.com",
    },
    datePublished: publishedDate,
    dateModified: modifiedDate || publishedDate,
  }),
  ...((schemaType === "Blog") && {
    name: title,
    author: {
      "@type": "Person",
      name: author,
      url: "https://www.onepiece.dejeloper.com",
    },
    description,
    image: ogimage,
    url,
  }),
};
---

<!-- Meta descripción -->
<meta name="description" content={description} />

<!-- Open Graph (para compartir en redes sociales) -->
<meta property="og:title" content={ogtitle} />
<meta property="og:description" content={ogdescription} />
<meta property="og:type" content={schemaType === "BlogPosting" ? "article" : "website"} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogimage} />
<meta property="og:site_name" content="El viaje hacia la libertad" />

{schemaType === "BlogPosting" && (
  <>
    <meta property="article:author" content={author} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
  </>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogtitle} />
<meta name="twitter:description" content={ogdescription} />
<meta name="twitter:image" content={ogimage} />

<!-- Autor -->
<meta name="author" content={author} />

<!-- Palabras clave -->
<meta name="keywords" content={`libro, blog, ${author} ${title} ${keywords}`} />

<!-- URL canónica -->
<link rel="canonical" href={url} />

<!-- Accesibilidad y rendimiento -->
<meta name="theme-color" content="#b7d6d8" />

<!-- Schema.org JSON-LD (para Google) -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<!-- Robots -->
<meta name="robots" content="index,follow" />

<!-- Copyright -->
<meta name="copyright" content="Fanfiction project - Non commercial" />
